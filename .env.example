# ==============================================================================
# APEX BANK MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Server
HOST=127.0.0.1
PORT=8000
DEBUG=True

# DSA Algorithmic Engine Parameters
DEFAULT_SLIDING_WINDOW_K=3
DEFAULT_FRAUD_THRESHOLD=50000.0

# SMTP Email Configuration (Optional - Mock console logger used if blank)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=security@apexbank.internal
SMTP_FROM_NAME=Apex National Bank
SMTP_USE_TLS=True

# Force Mock SMTP Mode (True to keep emails logged to in-memory audit log and console)
MOCK_SMTP_MODE=True
